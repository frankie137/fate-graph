{
  "number": 60,
  "judgment": "亨。苦节不可贞。",
  "tuan": "节，亨，刚柔分，而刚得中。苦节不可贞，其道穷也。说以行险，当位以节，中正以通。天地节而四时成，节以制度，不伤财，不害民。",
  "image": "泽上有水，节；君子以制数度，议德行。",
  "lines": [
    {
      "label": "初九",
      "text": "不出户庭，无咎。",
      "image": "不出户庭，知通塞也。"
    },
    {
      "label": "九二",
      "text": "不出门庭，凶。",
      "image": "不出门庭凶，失时极也。"
    },
    {
      "label": "六三",
      "text": "不节若，则嗟若，无咎。",
      "image": "不节之嗟，又谁咎也。"
    },
    {
      "label": "六四",
      "text": "安节，亨。",
      "image": "安节之亨，承上道也。"
    },
    {
      "label": "九五",
      "text": "甘节，吉；往有尚。",
      "image": "甘节之吉，居位中也。"
    },
    {
      "label": "上六",
      "text": "苦节，贞凶，悔亡。",
      "image": "苦节贞凶，其道穷也。"
    }
  ]
}
