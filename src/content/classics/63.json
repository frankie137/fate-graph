{
  "number": 63,
  "judgment": "亨小。利贞。初吉终乱。",
  "tuan": "既济，亨，小者亨也。利贞，刚柔正而位当也。初吉，柔得中也。终止则乱，其道穷也。",
  "image": "水在火上，既济；君子以思患而豫防之。",
  "lines": [
    {
      "label": "初九",
      "text": "曳其轮，濡其尾，无咎。",
      "image": "曳其轮，义无咎也。"
    },
    {
      "label": "六二",
      "text": "妇丧其茀，勿逐，七日得。",
      "image": "七日得，以中道也。"
    },
    {
      "label": "九三",
      "text": "高宗伐鬼方，三年克之，小人勿用。",
      "image": "三年克之，惫也。"
    },
    {
      "label": "六四",
      "text": "繻有衣袽，终日戒。",
      "image": "终日戒，有所疑也。"
    },
    {
      "label": "九五",
      "text": "东邻杀牛，不如西邻之禴祭，实受其福。",
      "image": "东邻杀牛，不如西邻之时也；实受其福，吉大来也。"
    },
    {
      "label": "上六",
      "text": "濡其首，厉。",
      "image": "濡其首厉，何可久也。"
    }
  ]
}
