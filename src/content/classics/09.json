{
  "number": 9,
  "judgment": "亨。密云不雨，自我西郊。",
  "tuan": "小畜，柔得位而上下应之，曰小畜。健而巽，刚中而志行，乃亨。密云不雨，尚往也。自我西郊，施未行也。",
  "image": "风行天上，小畜，君子以懿文德。",
  "lines": [
    {
      "label": "初九",
      "text": "复自道，何其咎，吉。",
      "image": "复自道，其义吉也。"
    },
    {
      "label": "九二",
      "text": "牵复，吉。",
      "image": "牵复在中，亦不自失也。"
    },
    {
      "label": "九三",
      "text": "舆说辐，夫妻反目。",
      "image": "夫妻反目，不能正室也。"
    },
    {
      "label": "六四",
      "text": "有孚，血去惕出，无咎。",
      "image": "有孚。惕出。上合志也。"
    },
    {
      "label": "九五",
      "text": "有孚挛如，富以其邻。",
      "image": "有孚挛如，不独富也。"
    },
    {
      "label": "上九",
      "text": "既雨既处，尚德载，妇贞厉，月几望，君子征凶。",
      "image": "既雨既处，德积载也。君子征凶，有所疑也。"
    }
  ]
}
