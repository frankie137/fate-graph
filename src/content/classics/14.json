{
  "number": 14,
  "judgment": "元亨。",
  "tuan": "大有，柔得尊位，大中而上下应之，曰大有。其德刚健而文明，应乎天而时行，是以元亨。",
  "image": "火在天上，大有；君子以遏恶扬善，顺天休命。",
  "lines": [
    {
      "label": "初九",
      "text": "无交害，匪咎，艰则无咎。",
      "image": "大有初九，无交害也。"
    },
    {
      "label": "九二",
      "text": "大车以载，有攸往，无咎。",
      "image": "大车以载，积中不败也。"
    },
    {
      "label": "九三",
      "text": "公用亨于天子，小人弗克。",
      "image": "公用亨于天子，小人害也。"
    },
    {
      "label": "九四",
      "text": "匪其彭，无咎。",
      "image": "匪其彭，无咎；明辨晰也。"
    },
    {
      "label": "六五",
      "text": "厥孚交如，威如；吉。",
      "image": "厥孚交如，信以发志也。威如之吉，易而无备也。"
    },
    {
      "label": "上九",
      "text": "自天祐之，吉无不利。",
      "image": "大有上吉，自天祐也。"
    }
  ]
}
