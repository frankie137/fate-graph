{
  "number": 46,
  "judgment": "元亨，用见大人，勿恤，南征吉。",
  "tuan": "柔以时升，巽而顺，刚中而应，是以大亨。用见大人，勿恤；有庆也。南征吉，志行也。",
  "image": "地中生木，升；君子以顺德，积小以高大。",
  "lines": [
    {
      "label": "初六",
      "text": "允升，大吉。",
      "image": "允升大吉，上合志也。"
    },
    {
      "label": "九二",
      "text": "孚乃利用禴，无咎。",
      "image": "九二之孚，有喜也。"
    },
    {
      "label": "九三",
      "text": "升虚邑。",
      "image": "升虚邑，无所疑也。"
    },
    {
      "label": "六四",
      "text": "王用亨于岐山，吉无咎。",
      "image": "王用亨于岐山，顺事也。"
    },
    {
      "label": "六五",
      "text": "贞吉，升阶。",
      "image": "贞吉升阶，大得志也。"
    },
    {
      "label": "上六",
      "text": "冥升，利于不息之贞。",
      "image": "冥升在上，消不富也。"
    }
  ]
}
