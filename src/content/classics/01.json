{
  "number": 1,
  "judgment": "元亨。利贞。",
  "tuan": "大哉乾元，万物资始，乃统天。云行雨施，品物流形，大明终始，六位时成。时乘六龙以御天，乾道变化，各正性命，保合大和，乃利贞。首出庶物，万国咸宁。",
  "image": "天行健，君子以自强不息。",
  "lines": [
    {
      "label": "初九",
      "text": "潜龙勿用。",
      "image": "潜龙勿用，阳在下也。"
    },
    {
      "label": "九二",
      "text": "见龙在田，利见大人。",
      "image": "见龙在田，德施普也。"
    },
    {
      "label": "九三",
      "text": "君子终日乾乾，夕惕若；厉，无咎。",
      "image": "终日乾乾，反复道也。"
    },
    {
      "label": "九四",
      "text": "或跃在渊，无咎。",
      "image": "或跃在渊，进无咎也。"
    },
    {
      "label": "九五",
      "text": "飞龙在天，利见大人。",
      "image": "飞龙在天，大人造也。"
    },
    {
      "label": "上九",
      "text": "亢龙，有悔。",
      "image": "亢龙有悔，盈不可久也。"
    },
    {
      "label": "用九",
      "text": "见群龙无首，吉。",
      "image": "用九，天德不可为首也。"
    }
  ]
}
