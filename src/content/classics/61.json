{
  "number": 61,
  "judgment": "豚鱼吉，利涉大川，利贞。",
  "tuan": "中孚，柔在内而刚得中。说而巽，孚，乃化邦也。豚鱼吉，信及豚鱼也。利涉大川，乘木舟虚也。中孚以利贞，乃应乎天也。",
  "image": "泽上有风，中孚；君子以议狱缓死。",
  "lines": [
    {
      "label": "初九",
      "text": "虞吉，有它不燕。",
      "image": "初九虞吉，志未变也。"
    },
    {
      "label": "九二",
      "text": "鸣鹤在阴，其子和之，我有好爵，吾与尔靡之。",
      "image": "其子和之，中心愿也。"
    },
    {
      "label": "六三",
      "text": "得敌，或鼓或罢，或泣或歌。",
      "image": "或鼓或罢，位不当也。"
    },
    {
      "label": "六四",
      "text": "月几望，马匹亡，无咎。",
      "image": "马匹亡，绝类上也。"
    },
    {
      "label": "九五",
      "text": "有孚挛如，无咎。",
      "image": "有孚挛如，位正当也。"
    },
    {
      "label": "上九",
      "text": "翰音登于天，贞凶。",
      "image": "翰音登于天，何可长也。"
    }
  ]
}
