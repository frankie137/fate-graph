{
  "number": 16,
  "judgment": "利建侯行师。",
  "tuan": "豫，刚应而志行，顺以动，豫。豫，顺以动，故天地如之，而况建侯行师乎？天地以顺动，故日月不过，而四时不忒；圣人以顺动，则刑罚清而民服。豫之时义大矣哉！",
  "image": "雷出地奋，豫。先王以作乐崇德，殷荐之上帝，以配祖考。",
  "lines": [
    {
      "label": "初六",
      "text": "鸣豫，凶。",
      "image": "初六鸣豫，志穷凶也。"
    },
    {
      "label": "六二",
      "text": "介于石，不终日，贞吉。",
      "image": "不终日，贞吉；以中正也。"
    },
    {
      "label": "六三",
      "text": "盱豫，悔。迟有悔。",
      "image": "盱豫有悔，位不当也。"
    },
    {
      "label": "九四",
      "text": "由豫，大有得。勿疑。朋盍簪。",
      "image": "由豫，大有得；志大行也。"
    },
    {
      "label": "六五",
      "text": "贞疾，恒不死。",
      "image": "六五贞疾，乘刚也。恒不死，中未亡也。"
    },
    {
      "label": "上六",
      "text": "冥豫，成有渝，无咎。",
      "image": "冥豫在上，何可长也。"
    }
  ]
}
