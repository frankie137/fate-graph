{
  "number": 58,
  "judgment": "亨。利贞。",
  "tuan": "兑，说也。刚中而柔外，说以利贞，是以顺乎天，而应乎人。说以先民，民忘其劳；说以犯难，民忘其死；说之大，民劝矣哉！",
  "image": "丽泽，兑；君子以朋友讲习。",
  "lines": [
    {
      "label": "初九",
      "text": "和兑，吉。",
      "image": "和兑之吉，行未疑也。"
    },
    {
      "label": "九二",
      "text": "孚兑，吉，悔亡。",
      "image": "孚兑之吉，信志也。"
    },
    {
      "label": "六三",
      "text": "来兑，凶。",
      "image": "来兑之凶，位不当也。"
    },
    {
      "label": "九四",
      "text": "商兑，未宁，介疾有喜。",
      "image": "九四之喜，有庆也。"
    },
    {
      "label": "九五",
      "text": "孚于剥，有厉。",
      "image": "孚于剥，位正当也。"
    },
    {
      "label": "上六",
      "text": "引兑。",
      "image": "上六引兑，未光也。"
    }
  ]
}
