{
  "number": 59,
  "judgment": "亨，王假有庙，利涉大川，利贞。",
  "tuan": "涣，亨。刚来而不穷，柔得位乎外而上同。王假有庙，王乃在中也。利涉大川，乘木有功也。",
  "image": "风行水上，涣；先王以享于帝立庙。",
  "lines": [
    {
      "label": "初六",
      "text": "用拯马壮，吉。",
      "image": "初六之吉，顺也。"
    },
    {
      "label": "九二",
      "text": "涣奔其机，悔亡。",
      "image": "涣奔其机，得愿也。"
    },
    {
      "label": "六三",
      "text": "涣其躬，无悔。",
      "image": "涣其躬，志在外也。"
    },
    {
      "label": "六四",
      "text": "涣其群，元吉。涣有丘，匪夷所思。",
      "image": "涣其群，元吉；光大也。"
    },
    {
      "label": "九五",
      "text": "涣汗其大号，涣王居，无咎。",
      "image": "王居无咎，正位也。"
    },
    {
      "label": "上九",
      "text": "涣其血，去逖出，无咎。",
      "image": "涣其血，远害也。"
    }
  ]
}
