{
  "number": 33,
  "judgment": "亨。小利贞。",
  "tuan": "遁亨，遁而亨也。刚当位而应，与时行也。小利贞，浸而长也。遁之时义大矣哉！",
  "image": "天下有山，遁；君子以远小人，不恶而严。",
  "lines": [
    {
      "label": "初六",
      "text": "遁尾，厉，勿用有攸往。",
      "image": "遁尾之厉，不往何灾也。"
    },
    {
      "label": "六二",
      "text": "执之用黄牛之革，莫之胜说。",
      "image": "执用黄牛，固志也。"
    },
    {
      "label": "九三",
      "text": "系遁，有疾厉，畜臣妾吉。",
      "image": "系遁之厉，有疾惫也。畜臣妾吉，不可大事也。"
    },
    {
      "label": "九四",
      "text": "好遁君子吉，小人否。",
      "image": "君子好遁，小人否也。"
    },
    {
      "label": "九五",
      "text": "嘉遁，贞吉。",
      "image": "嘉遁贞吉，以正志也。"
    },
    {
      "label": "上九",
      "text": "肥遁，无不利。",
      "image": "肥遁，无不利；无所疑也。"
    }
  ]
}
