{
  "number": 39,
  "judgment": "利西南，不利东北；利见大人，贞吉。",
  "tuan": "蹇，难也，险在前也。见险而能止，知矣哉！蹇利西南，往得中也；不利东北，其道穷也。利见大人，往有功也。当位贞吉，以正邦也。蹇之时用大矣哉！",
  "image": "山上有水，蹇；君子以反身修德。",
  "lines": [
    {
      "label": "初六",
      "text": "往蹇，来誉。",
      "image": "往蹇来誉，宜待也。"
    },
    {
      "label": "六二",
      "text": "王臣蹇蹇，匪躬之故。",
      "image": "王臣蹇蹇，终无尤也。"
    },
    {
      "label": "九三",
      "text": "往蹇来反。",
      "image": "往蹇来反，内喜之也。"
    },
    {
      "label": "六四",
      "text": "往蹇来连。",
      "image": "往蹇来连，当位实也。"
    },
    {
      "label": "九五",
      "text": "大蹇朋来。",
      "image": "大蹇朋来，以中节也。"
    },
    {
      "label": "上六",
      "text": "往蹇来硕，吉；利见大人。",
      "image": "往蹇来硕，志在内也。利见大人，以从贵也。"
    }
  ]
}
