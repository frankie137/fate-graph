{
  "number": 23,
  "judgment": "不利有攸往。",
  "tuan": "剥，剥也，柔变刚也。不利有攸往，小人长也。顺而止之，观象也。君子尚消息盈虚，天行也。",
  "image": "山附于地，剥；上以厚下，安宅。",
  "lines": [
    {
      "label": "初六",
      "text": "剥床以足，蔑贞凶。",
      "image": "剥床以足，以灭下也。"
    },
    {
      "label": "六二",
      "text": "剥床以辨，蔑贞凶。",
      "image": "剥床以辨，未有与也。"
    },
    {
      "label": "六三",
      "text": "剥之，无咎。",
      "image": "剥之无咎，失上下也。"
    },
    {
      "label": "六四",
      "text": "剥床以肤，凶。",
      "image": "剥床以肤，切近灾也。"
    },
    {
      "label": "六五",
      "text": "贯鱼，以宫人宠，无不利。",
      "image": "以宫人宠，终无尤也。"
    },
    {
      "label": "上九",
      "text": "硕果不食，君子得舆，小人剥庐。",
      "image": "君子得舆，民所载也。小人剥庐，终不可用也。"
    }
  ]
}
