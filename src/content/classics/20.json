{
  "number": 20,
  "judgment": "盥而不荐，有孚颙若。",
  "tuan": "大观在上，顺而巽，中正以观天下。观，盥而不荐，有孚颙若，下观而化也。观天之神道，而四时不忒，圣人以神道设教，而天下服矣。",
  "image": "风行地上，观；先王以省方，观民设教。",
  "lines": [
    {
      "label": "初六",
      "text": "童观，小人无咎，君子吝。",
      "image": "初六童观，小人道也。"
    },
    {
      "label": "六二",
      "text": "窥观，利女贞。",
      "image": "窥观女贞，亦可丑也。"
    },
    {
      "label": "六三",
      "text": "观我生，进退。",
      "image": "观我生，进退；未失道也。"
    },
    {
      "label": "六四",
      "text": "观国之光，利用宾于王。",
      "image": "观国之光，尚宾也。"
    },
    {
      "label": "九五",
      "text": "观我生，君子无咎。",
      "image": "观我生，观民也。"
    },
    {
      "label": "上九",
      "text": "观其生，君子无咎。",
      "image": "观其生，志未平也。"
    }
  ]
}
