{
  "number": 37,
  "judgment": "利女贞。",
  "tuan": "家人，女正位乎内，男正位乎外，男女正，天地之大义也。家人有严君焉，父母之谓也。父父，子子，兄兄，弟弟，夫夫，妇妇，而家道正；正家而天下定矣。",
  "image": "风自火出，家人；君子以言有物，而行有恒。",
  "lines": [
    {
      "label": "初九",
      "text": "闲有家，悔亡。",
      "image": "闲有家，志未变也。"
    },
    {
      "label": "六二",
      "text": "无攸遂，在中馈，贞吉。",
      "image": "六二之吉，顺以巽也。"
    },
    {
      "label": "九三",
      "text": "家人嗃嗃，悔厉吉；妇子嘻嘻，终吝。",
      "image": "家人嗃嗃，未失也；妇子嘻嘻，失家节也。"
    },
    {
      "label": "六四",
      "text": "富家，大吉。",
      "image": "富家大吉，顺在位也。"
    },
    {
      "label": "九五",
      "text": "王假有家，勿恤。吉。",
      "image": "王假有家，交相爱也。"
    },
    {
      "label": "上九",
      "text": "有孚威如，终吉。",
      "image": "威如之吉，反身之谓也。"
    }
  ]
}
