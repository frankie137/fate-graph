{
  "number": 26,
  "judgment": "利贞，不家食吉，利涉大川。",
  "tuan": "大畜，刚健笃实辉光，日新其德，刚上而尚贤。能止健，大正也。不家食吉，养贤也。利涉大川，应乎天也。",
  "image": "天在山中，大畜；君子以多识前言往行，以畜其德。",
  "lines": [
    {
      "label": "初九",
      "text": "有厉利已。",
      "image": "有厉利已，不犯灾也。"
    },
    {
      "label": "九二",
      "text": "舆说輹。",
      "image": "舆说輹，中无尤也。"
    },
    {
      "label": "九三",
      "text": "良马逐，利艰贞。曰闲舆卫，利有攸往。",
      "image": "利有攸往，上合志也。"
    },
    {
      "label": "六四",
      "text": "童牛之牿，元吉。",
      "image": "六四元吉，有喜也。"
    },
    {
      "label": "六五",
      "text": "豮豕之牙，吉。",
      "image": "六五之吉，有庆也。"
    },
    {
      "label": "上九",
      "text": "何天之衢，亨。",
      "image": "何天之衢，道大行也。"
    }
  ]
}
