{
  "number": 18,
  "judgment": "元亨。利涉大川。先甲三日，后甲三日。",
  "tuan": "蛊，刚上而柔下，巽而止，蛊。蛊，元亨，而天下治也。利涉大川，往有事也。先甲三日，后甲三日，终则有始，天行也。",
  "image": "山下有风，蛊；君子以振民育德。",
  "lines": [
    {
      "label": "初六",
      "text": "干父之蛊，有子考，无咎，厉终吉。",
      "image": "干父之蛊，意承考也。"
    },
    {
      "label": "九二",
      "text": "干母之蛊，不可贞。",
      "image": "干母之蛊，得中道也。"
    },
    {
      "label": "九三",
      "text": "干父之蛊，小有悔，无大咎。",
      "image": "干父之蛊，终无咎也。"
    },
    {
      "label": "六四",
      "text": "裕父之蛊，往见吝。",
      "image": "裕父之蛊，往未得也。"
    },
    {
      "label": "六五",
      "text": "干父之蛊，用誉。",
      "image": "干父用誉，承以德也。"
    },
    {
      "label": "上九",
      "text": "不事王侯，高尚其事。",
      "image": "不事王侯，志可则也。"
    }
  ]
}
