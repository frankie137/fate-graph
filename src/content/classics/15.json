{
  "number": 15,
  "judgment": "亨，君子有终。",
  "tuan": "谦，亨，天道下济而光明，地道卑而上行。天道亏盈而益谦，地道变盈而流谦，鬼神害盈而福谦，人道恶盈而好谦。谦尊而光，卑而不可逾，君子之终也。",
  "image": "地中有山，谦；君子以裒多益寡，称物平施。",
  "lines": [
    {
      "label": "初六",
      "text": "谦谦君子，用涉大川，吉。",
      "image": "谦谦君子，卑以自牧也。"
    },
    {
      "label": "六二",
      "text": "鸣谦，贞吉。",
      "image": "鸣谦贞吉，中心得也。"
    },
    {
      "label": "九三",
      "text": "劳谦君子，有终吉。",
      "image": "劳谦君子，万民服也。"
    },
    {
      "label": "六四",
      "text": "无不利，撝谦。",
      "image": "无不利撝谦；不违则也。"
    },
    {
      "label": "六五",
      "text": "不富，以其邻，利用侵伐，无不利。",
      "image": "利用侵伐，征不服也。"
    },
    {
      "label": "上六",
      "text": "鸣谦，利用行师，征邑国。",
      "image": "鸣谦，志未得也。可用行师，征邑国也。"
    }
  ]
}
