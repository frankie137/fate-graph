{
  "number": 12,
  "judgment": "否之匪人，不利君子贞，大往小来。",
  "tuan": "否之匪人，不利君子贞，大往小来。则是天地不交而万物不通也，上下不交而天下无邦也。内阴而外阳，内柔而外刚，内小人而外君子，小人道长，君子道消也。",
  "image": "天地不交，否；君子以俭德辟难，不可荣以禄。",
  "lines": [
    {
      "label": "初六",
      "text": "拔茅茹以其汇，贞吉。亨。",
      "image": "拔茅贞吉，志在君也。"
    },
    {
      "label": "六二",
      "text": "包承，小人吉，大人否。亨。",
      "image": "大人否，亨。不乱群也。"
    },
    {
      "label": "六三",
      "text": "包羞。",
      "image": "包羞，位不当也。"
    },
    {
      "label": "九四",
      "text": "有命，无咎，畴离祉。",
      "image": "有命无咎，志行也。"
    },
    {
      "label": "九五",
      "text": "休否，大人吉。其亡其亡，系于苞桑。",
      "image": "大人之吉，位正当也。"
    },
    {
      "label": "上九",
      "text": "倾否，先否后喜。",
      "image": "否终则倾，何可长也。"
    }
  ]
}
