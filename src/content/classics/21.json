{
  "number": 21,
  "judgment": "亨。利用狱。",
  "tuan": "颐中有物，曰噬嗑，噬嗑而亨。刚柔分，动而明，雷电合而章。柔得中而上行，虽不当位，利用狱也。",
  "image": "雷电噬嗑；先王以明罚敕法。",
  "lines": [
    {
      "label": "初九",
      "text": "屦校灭趾，无咎。",
      "image": "屦校灭趾，不行也。"
    },
    {
      "label": "六二",
      "text": "噬肤灭鼻，无咎。",
      "image": "噬肤灭鼻，乘刚也。"
    },
    {
      "label": "六三",
      "text": "噬腊肉，遇毒；小吝，无咎。",
      "image": "遇毒，位不当也。"
    },
    {
      "label": "九四",
      "text": "噬干胏，得金矢，利艰贞，吉。",
      "image": "利艰贞吉，未光也。"
    },
    {
      "label": "六五",
      "text": "噬干肉，得黄金，贞厉，无咎。",
      "image": "贞厉无咎，得当也。"
    },
    {
      "label": "上九",
      "text": "何校灭耳，凶。",
      "image": "何校灭耳，聪不明也。"
    }
  ]
}
